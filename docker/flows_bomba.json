  {
    "id": "w_move_cmd",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_cmds",
    "order": 7,
    "width": 6,
    "height": 2,
    "name": "Mover (um, um/s)",
    "format": "<template>\n  <div style=\"padding:8px 4px\">\n    <div style=\"font-size:11px;color:#9e9e9e;margin-bottom:8px;letter-spacing:.05em\">MOVIMIENTO LINEAL</div>\n    <div style=\"display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap\">\n      <div style=\"flex:1;min-width:110px\">\n        <div style=\"font-size:10px;color:#9e9e9e;margin-bottom:3px\">Posición (um)</div>\n        <input type=\"number\" v-model.number=\"pos\" min=\"0\" step=\"1000\"\n          style=\"width:100%;box-sizing:border-box;background:#1e1e1e;color:#fff;\n                 border:1px solid #555;border-radius:4px;padding:6px 8px;font-size:14px\"/>\n      </div>\n      <div style=\"flex:1;min-width:110px\">\n        <div style=\"font-size:10px;color:#9e9e9e;margin-bottom:3px\">Velocidad (um/s)</div>\n        <input type=\"number\" v-model.number=\"vel\" min=\"1\" max=\"5000\" step=\"100\"\n          style=\"width:100%;box-sizing:border-box;background:#1e1e1e;color:#fff;\n                 border:1px solid #555;border-radius:4px;padding:6px 8px;font-size:14px\"/>\n      </div>\n      <button\n        @click=\"pos > 0 && vel > 0 && send({payload: pos.toFixed(1)+','+vel.toFixed(1)})\"\n        :style=\"{opacity: pos>0 && vel>0 ? 1 : 0.4,\n                 height:'34px',padding:'0 16px',background:'#1976d2',\n                 color:'#fff',border:'none',borderRadius:'4px',\n                 fontSize:'13px',cursor:'pointer',whiteSpace:'nowrap'}\"\n      >&#9654; Mover</button>\n    </div>\n  </div>\n</template>\n<script>\n  export default {\n    data() { return { pos: 30000, vel: 500 } }\n  }\n</script>",
    "storeState": true,
    "passthru": false,
    "className": "",
    "x": 210,
    "y": 520,
    "wires": [
      [
        "fn_mk_cmd"
      ]
    ],
    "templateScope": "local",
    "resendOnReconnect": true
  }
