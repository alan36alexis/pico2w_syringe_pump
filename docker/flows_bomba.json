  {
    "id": "n_fault_out",
    "type": "mqtt out",
    "z": "fl_main",
    "name": "Sim Fault",
    "topic": "",
    "qos": "0",
    "retain": "",
    "broker": "cf_broker",
    "x": 960,
    "y": 580,
    "wires": []
  },
  {
    "id": "fn_telem",
    "type": "function",
    "z": "fl_main",
    "name": "Parse Telemetría",
    "func": "try {\n  const d = JSON.parse(msg.payload);\n  const parts = msg.topic.split('/');\n  const id = parts[1] || context.global.get('online_device_id') || 'device';\n  return [\n    { payload: d.rate },\n    { payload: d, deviceId: id },\n    { payload: d.pres, topic: id + ' pres' }\n  ];\n} catch(e) { return [null,null,null]; }",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 60,
    "wires": [
      [
        "w_rate"
      ],
      [
        "w_telem",
        "w_alm",
        "w_state"
      ],
      [
        "w_chart"
      ]
    ]
  },
  {
    "id": "fn_status",
    "type": "function",
    "z": "fl_main",
    "name": "Parse Status",
    "func": "try {\n  const d = JSON.parse(msg.payload);\n  if (d.id) context.global.set('online_device_id', d.id);\n  msg.payload = { state: d.state, id: d.id, fw: d.fw || 'sim', online: d.state === 'online' };\n  return msg;\n} catch(e) { return null; }",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 120,
    "wires": [
      [
        "w_device"
      ]
    ]
  },
  {
    "id": "fn_event",
    "type": "function",
    "z": "fl_main",
    "name": "Format Evento",
    "func": "try {\n  const d = JSON.parse(msg.payload);\n  const t = new Date().toLocaleTimeString('es-MX');\n  const STATES = ['DETENIDA','INFUSANDO','BOLUS','PURGA','KVO','PAUSADA','ALARMA'];\n  let log = context.global.get('event_log') || [];\n  let detail = d.type === 'alarm'\n    ? 'ALARMA ' + (d.code||'').toUpperCase() + ' lvl ' + d.level\n    : d.type === 'state'\n    ? (STATES[d.from] || d.from) + ' → ' + (STATES[d.to] || d.to)\n    : (d.msg || JSON.stringify(d));\n  log.unshift({ time: t, tipo: d.type || 'info', detalle: detail });\n  if (log.length > 25) log = log.slice(0, 25);\n  context.global.set('event_log', log);\n  const notif = d.type === 'alarm'\n    ? { payload: '⚠ ALARMA: ' + (d.code||'').toUpperCase() + ' (nivel ' + d.level + ')', topic: 'error' }\n    : null;\n  return [{ payload: log }, notif];\n} catch(e) {\n  node.error('fn_event ERROR: ' + e.message, msg);\n  return [null, null];\n}",
    "outputs": 2,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 180,
    "wires": [
      [
        "w_events"
      ],
      [
        "w_notif"
      ]
    ]
  },
  {
    "id": "fn_ack",
    "type": "function",
    "z": "fl_main",
    "name": "Format ACK",
    "func": "try {\n  const d = JSON.parse(msg.payload);\n  msg.payload = '#' + d.cid + ': ' + d.result + (d.reason ? ' (' + d.reason + ')' : '');\n  return msg;\n} catch(e) { return null; }",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 240,
    "wires": [
      [
        "w_ack"
      ]
    ]
  },
  {
    "id": "fn_mk_cmd",
    "type": "function",
    "z": "fl_main",
    "name": "Make CMD",
    "func": "const devId = context.global.get('online_device_id') || 'bj-deadbeef';\nmsg.topic = 'bj/' + devId + '/cmd';\n// msg.payload ya es el string de comando (ej: 'stop', '30000.0,500.0')\n// PR3: envolver en {cid, cmd} cuando el firmware soporte el JSON envelope\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 760,
    "y": 500,
    "wires": [
      [
        "n_cmd_out"
      ]
    ]
  },
  {
    "id": "fn_fault_topic",
    "type": "function",
    "z": "fl_main",
    "name": "Fault Topic",
    "func": "msg.topic = 'bj/bj-deadbeef/sim_fault'; return msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 760,
    "y": 580,
    "wires": [
      [
        "n_fault_out"
      ]
    ]
  },
  {
    "id": "w_device",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_dev",
    "name": "Dispositivo",
    "order": 1,
    "width": 6,
    "height": 2,
    "storeState": true,
    "passthru": false,
    "resendOnReconnect": true,
    "templateScope": "local",
    "className": "",
    "x": 560,
    "y": 120,
    "wires": [],
    "format": "<template>\n  <div style=\"padding:8px\">\n    <div style=\"display:flex;align-items:center;gap:8px\">\n      <div :style=\"{width:'10px',height:'10px',borderRadius:'50%',background:msg.payload&&msg.payload.online?'#4caf50':'#f44336'}\"></div>\n      <b style=\"font-size:16px\">{{ msg.payload && msg.payload.id || '—' }}</b>\n    </div>\n    <div style=\"font-size:11px;opacity:0.6;margin-top:4px\">fw: {{ msg.payload && msg.payload.fw || '—' }}</div>\n  </div>\n</template>"
  },
  {
    "id": "w_state",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_state",
