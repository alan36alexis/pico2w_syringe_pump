    "wires": []
  },
  {
    "id": "fn_telem",
    "type": "function",
    "z": "fl_main",
    "name": "Parse Telemetría",
    "func": "try {\n  const d = JSON.parse(msg.payload);\n  const parts = msg.topic.split('/');\n  const id = parts[1] || context.global.get('online_device_id') || 'device';\n  return [\n    { payload: d.rate },\n    { payload: d, deviceId: id },\n    { payload: d.pres, topic: id + ' pres' }\n  ];\n} catch(e) { return [null,null,null]; }",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 60,
    "wires": [
      ["w_rate"],
      ["w_telem", "w_alm", "w_state"],
      ["w_chart"]
    ]
  },
  {
    "id": "fn_status",
    "type": "function",
    "z": "fl_main",
    "name": "Parse Status",
    "func": "try {\n  const d = JSON.parse(msg.payload);\n  if (d.id) context.global.set('online_device_id', d.id);\n  msg.payload = { state: d.state, id: d.id, fw: d.fw || 'sim', online: d.state === 'online' };\n  return msg;\n} catch(e) { return null; }",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 120,
    "wires": [["w_device"]]
  },
  {
    "id": "fn_event",
    "type": "function",
    "z": "fl_main",
    "name": "Format Evento",
    "func": "try {\n  const d = JSON.parse(msg.payload);\n  const t = new Date().toLocaleTimeString('es-MX');\n  const CORE1 = [\n    'ESPERANDO','HOMING','REL_LSW_INI','COLOQUE JERINGA',\n    'BUSCANDO JERINGA','JERINGA OK','DISPENSANDO','FIN DE DISPENSADO',\n    'NUEVO_DISP','BUSCANDO_EOT','FRENANDO_EOT','FIN DE RECORRIDO',\n    'FALLA','OCLUSIÓN','OCC_LIBERANDO','OCC_PAUSADO',\n    'MANUAL','INICIANDO CALIBRACIÓN','CALIBRANDO...','FREN_LSW_INI','FREN_LSW_FIN'\n  ];\n  let log = context.global.get('event_log') || [];\n  let detail, fsmMsg = null;\n  if (d.type === 'alarm') {\n    detail = 'ALARMA ' + (d.code||'').toUpperCase() + ' lvl ' + d.level;\n  } else if (d.type === 'state') {\n    const from = CORE1[d.from] !== undefined ? CORE1[d.from] : String(d.from);\n    const to   = CORE1[d.to]   !== undefined ? CORE1[d.to]   : String(d.to);\n    detail = from + ' → ' + to;\n    context.global.set('fsm_state', d.to);\n    fsmMsg = { payload: { fsm_from: d.from, fsm_to: d.to } };\n  } else {\n    detail = d.msg || JSON.stringify(d);\n  }\n  log.unshift({ time: t, tipo: d.type || 'info', detalle: detail });\n  if (log.length > 25) log = log.slice(0, 25);\n  context.global.set('event_log', log);\n  const notif = d.type === 'alarm'\n    ? { payload: '⚠ ALARMA: ' + (d.code||'').toUpperCase() + ' (nivel ' + d.level + ')', topic: 'error' }\n    : null;\n  return [{ payload: log }, notif, fsmMsg];\n} catch(e) {\n  node.error('fn_event: ' + e.message, msg);\n  return [null, null, null];\n}",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 180,
    "wires": [
      ["w_events"],
      ["w_notif"],
      ["w_state", "w_fsm_state_ctrl"]
    ]
  },
  {
    "id": "fn_ack",
    "type": "function",
    "z": "fl_main",
    "name": "Format ACK",
    "func": "try {\n  const d = JSON.parse(msg.payload);\n  msg.payload = '#' + d.cid + ': ' + d.result + (d.reason ? ' (' + d.reason + ')' : '');\n  return msg;\n} catch(e) { return null; }",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 240,
    "wires": [["w_ack"]]
  },
  {
    "id": "fn_mk_cmd",
    "type": "function",
    "z": "fl_main",
    "name": "Make CMD",
    "func": "const devId = context.global.get('online_device_id') || 'bj-deadbeef';\nlet cid = (context.global.get('cmd_cid') || 0) + 1;\ncontext.global.set('cmd_cid', cid);\nmsg.topic = 'bj/' + devId + '/cmd';\nmsg.payload = JSON.stringify({ cid: cid, cmd: String(msg.payload) });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 760,
    "y": 500,
    "wires": [["n_cmd_out"]]
  },
  {
    "id": "fn_fault_topic",
    "type": "function",
    "z": "fl_main",
    "name": "Fault Topic",
    "func": "const devId = context.global.get('online_device_id') || 'bj-deadbeef';\nmsg.topic = 'bj/' + devId + '/sim_fault';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 760,
    "y": 580,
    "wires": [["n_fault_out"]]
  },
  {
    "id": "w_device",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_dev",
    "name": "Dispositivo",
    "order": 1,
    "width": 6,
    "height": 2,
    "storeState": true,
    "passthru": false,
    "resendOnReconnect": true,
    "templateScope": "local",
    "className": "",
    "x": 560,
    "y": 120,
    "wires": [],
    "format": "<template>\n  <div style=\"padding:8px\">\n    <div style=\"display:flex;align-items:center;gap:8px\">\n      <div :style=\"{width:'10px',height:'10px',borderRadius:'50%',background:msg.payload&&msg.payload.online?'#4caf50':'#f44336'}\"></div>\n      <b style=\"font-size:16px\">{{ msg.payload && msg.payload.id || '—' }}</b>\n    </div>\n    <div style=\"font-size:11px;opacity:0.6;margin-top:4px\">fw: {{ msg.payload && msg.payload.fw || '—' }}</div>\n  </div>\n</template>"
  },
  {
    "id": "w_state",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_state",
    "name": "Estado",
    "order": 1,
    "width": 6,
    "height": 3,
    "storeState": true,
    "passthru": false,
    "resendOnReconnect": true,
    "templateScope": "local",
    "className": "",
    "x": 560,
    "y": 60,
    "wires": [],
    "format": "<template>\n  <div style=\"padding:10px;text-align:center\">\n    <div style=\"font-size:9px;letter-spacing:.1em;opacity:0.5;margin-bottom:3px\">BOMBA (API)</div>\n    <div :style=\"{fontSize:'18px',fontWeight:'bold',color:pumpColor,transition:'color 0.3s'}\">{{ pumpLabel }}</div>\n    <div style=\"border-top:1px solid #333;margin:8px 0\"></div>\n    <div style=\"font-size:9px;letter-spacing:.1em;opacity:0.5;margin-bottom:3px\">MOTOR (FSM)</div>\n    <div :style=\"{fontSize:'14px',fontWeight:'bold',color:fsmColor,transition:'color 0.3s'}\">{{ fsmLabel }}</div>\n    <div v-if=\"fsmSt !== null\" style=\"font-size:10px;opacity:0.4;margin-top:2px\">#{{ fsmSt }}</div>\n  </div>\n</template>\n<script>\n  const PUMP_LABELS = ['DETENIDA','INFUSANDO','BOLUS','PURGA','KVO','PAUSADA','ALARMA'];\n  const PUMP_COLORS = ['#9e9e9e','#4caf50','#2196f3','#ff9800','#9c27b0','#ffb300','#f44336'];\n  const CORE1_LABELS = [\n    'ESPERANDO','HOMING','REL_LSW_INI','COLOQUE JERINGA',\n    'BUSCANDO JERINGA','JERINGA OK','DISPENSANDO','FIN DE DISPENSADO',\n    'NUEVO DISP','BUSCANDO EOT','FRENANDO EOT','FIN DE RECORRIDO',\n    'FALLA','OCLUSIÓN','OCC LIBERANDO','OCC PAUSADO',\n    'MANUAL','INICIANDO CALIBRACIÓN','CALIBRANDO...','FREN LSW INI','FREN LSW FIN'\n  ];\n  const CORE1_COLORS = [\n    '#9e9e9e','#ffb300','#ffb300','#4caf50',\n    '#2196f3','#2196f3','#4caf50','#9e9e9e',\n    '#9e9e9e','#2196f3','#ffb300','#9e9e9e',\n    '#f44336','#f44336','#ffb300','#ff9800',\n    '#9c27b0','#00bcd4','#00bcd4','#ffb300','#ffb300'\n  ];\n  export default {\n    data() { return { pumpSt: null, fsmSt: null } },\n    computed: {\n      pumpLabel() { return this.pumpSt != null ? (PUMP_LABELS[this.pumpSt] || '—') : '—' },\n      pumpColor() { return this.pumpSt != null ? (PUMP_COLORS[this.pumpSt] || '#9e9e9e') : '#9e9e9e' },\n      fsmLabel()  { return this.fsmSt  != null ? (CORE1_LABELS[this.fsmSt] || String(this.fsmSt)) : 'SIN DATOS' },\n      fsmColor()  { return this.fsmSt  != null ? (CORE1_COLORS[this.fsmSt] || '#9e9e9e') : '#555' }\n    },\n    watch: {\n      'msg.payload': {\n        immediate: true,\n        handler(d) {\n          if (!d) return;\n          if (d.st != null)     this.pumpSt = d.st;\n          if (d.fsm_to != null) this.fsmSt  = d.fsm_to;\n        }\n      }\n    }\n  }\n</script>"
  },
  {
    "id": "w_telem",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_telem",
    "name": "Stats Infusión",
    "order": 1,
    "width": 6,
    "height": 2,
    "storeState": true,
    "passthru": false,
    "resendOnReconnect": true,
    "templateScope": "local",
    "className": "",
    "x": 560,
    "y": 180,
    "wires": [],
    "format": "<template>\n  <div style=\"padding:8px;font-size:13px\">\n    <div style=\"display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid #333\">\n      <span>Infundido</span>\n      <b>{{ msg.payload && msg.payload.vol_inf != null ? msg.payload.vol_inf.toFixed(2) : '—' }} mL</b>\n    </div>\n    <div style=\"display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid #333\">\n      <span>Objetivo</span>\n      <b>{{ msg.payload && msg.payload.vol_tgt != null ? msg.payload.vol_tgt.toFixed(2) : '—' }} mL</b>\n    </div>\n    <div style=\"display:flex;justify-content:space-between;padding:5px 0;border-bottom:1px solid #333\">\n      <span>Transcurrido</span>\n      <b>{{ msg.payload && msg.payload.t_ela_s ? (Math.floor(msg.payload.t_ela_s/3600)+'h '+Math.floor(msg.payload.t_ela_s%3600/60)+'m '+Math.floor(msg.payload.t_ela_s%60)+'s') : '0h 0m 0s' }}</b>\n    </div>\n    <div style=\"display:flex;justify-content:space-between;padding:5px 0\">\n      <span>Restante</span>\n      <b>{{ msg.payload && msg.payload.t_rem_h > 0 ? (msg.payload.t_rem_h * 60).toFixed(1)+' min' : '—' }}</b>\n    </div>\n  </div>\n</template>"
  },
  {
    "id": "w_rate",
    "type": "ui-gauge",
    "z": "fl_main",
    "group": "grp_rate",
    "name": "Caudal",
    "order": 1,
    "width": 6,
    "height": 4,
    "label": "Caudal",
    "format": "{{value}} mL/h",
    "gtype": "gauge-half",
    "gstyle": "needle",
    "min": 0,
    "max": 500,
    "sizeThickness": 16,
    "sizeGap": 4,
    "sizeKeyThickness": 8,
    "styleRounded": true,
    "styleGlow": false,
    "segments": [
      {"from": 0,   "color": "#4caf50"},
      {"from": 200, "color": "#ffb300"},
      {"from": 400, "color": "#f44336"}
    ],
    "className": "",
    "x": 560,
    "y": 60,
    "wires": []
  },
  {
    "id": "w_chart",
    "type": "ui-chart",
    "z": "fl_main",
    "group": "grp_chart",
    "name": "Fuerza ADC",
    "label": "Fuerza sensor ADC (mmHg)",
    "order": 1,
    "chartType": "line",
    "category": "topic",
    "categoryType": "msg",
    "xAxisType": "time",
    "xAxisFormat": "HH:mm:ss",
    "removeOlder": 5,
    "removeOlderUnit": "60",
    "removeOlderPoints": "",
    "colors": ["#1565C0", "#E53935"],
    "width": 12,
    "height": 4,
    "className": "",
    "x": 560,
    "y": 280,
    "wires": []
  },
  {
    "id": "w_alm",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_alm",
    "name": "Alarmas",
    "order": 1,
    "width": 12,
    "height": 2,
    "storeState": true,
    "passthru": false,
    "resendOnReconnect": true,
    "templateScope": "local",
    "className": "",
    "x": 560,
    "y": 380,
    "wires": [],
    "format": "<template>\n  <div style=\"display:flex;flex-wrap:wrap;gap:8px;padding:8px\">\n    <span v-for=\"(v,k) in (msg.payload && msg.payload.alm || {})\" :key=\"k\"\n          :style=\"{padding:'4px 14px',borderRadius:'4px',fontWeight:'bold',fontSize:'13px',\n                   background:v?'#b71c1c':'#1b5e20',color:'#fff',transition:'background 0.3s'}\">\n      {{ k.toUpperCase() }}: {{ v ? '⚠' : '✓' }}\n    </span>\n  </div>\n</template>"
  },
  {
    "id": "w_fsm_state_ctrl",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_fsm_status",
    "name": "Estado FSM",
    "order": 1,
    "width": 12,
    "height": 2,
    "storeState": true,
    "passthru": false,
    "resendOnReconnect": true,
    "templateScope": "local",
    "className": "",
    "x": 700,
    "y": 600,
    "wires": [],
    "format": "<template>\n  <div style=\"display:flex;align-items:center;justify-content:center;gap:24px;padding:12px;height:100%\">\n    <div style=\"text-align:center\">\n      <div style=\"font-size:9px;letter-spacing:.12em;opacity:0.4;margin-bottom:6px\">ESTADO MOTOR (Core1 FSM)</div>\n      <div :style=\"{fontSize:'32px',fontWeight:'bold',color:fsmColor,transition:'color 0.4s',letterSpacing:'.02em'}\">{{ fsmLabel }}</div>\n      <div v-if=\"fsmSt !== null\" style=\"font-size:11px;opacity:0.35;margin-top:4px\">estado #{{ fsmSt }}</div>\n    </div>\n    <div :style=\"{width:'14px',height:'14px',borderRadius:'50%',background:fsmColor,boxShadow:'0 0 8px '+fsmColor,transition:'background 0.4s',flexShrink:0}\"></div>\n  </div>\n</template>\n<script>\n  const CORE1_LABELS = [\n    'ESPERANDO','HOMING','REL_LSW_INI','COLOQUE JERINGA',\n    'BUSCANDO JERINGA','JERINGA OK','DISPENSANDO','FIN DE DISPENSADO',\n    'NUEVO DISP','BUSCANDO EOT','FRENANDO EOT','FIN DE RECORRIDO',\n    'FALLA','OCLUSIÓN','OCC LIBERANDO','OCC PAUSADO',\n    'MANUAL','INICIANDO CALIBRACIÓN','CALIBRANDO...','FREN LSW INI','FREN LSW FIN'\n  ];\n  const CORE1_COLORS = [\n    '#9e9e9e','#ffb300','#ffb300','#4caf50',\n    '#2196f3','#2196f3','#4caf50','#9e9e9e',\n    '#9e9e9e','#2196f3','#ffb300','#9e9e9e',\n    '#f44336','#f44336','#ffb300','#ff9800',\n    '#9c27b0','#00bcd4','#00bcd4','#ffb300','#ffb300'\n  ];\n  export default {\n    data() { return { fsmSt: null } },\n    computed: {\n      fsmLabel() { return this.fsmSt != null ? (CORE1_LABELS[this.fsmSt] || String(this.fsmSt)) : 'SIN DATOS' },\n      fsmColor() { return this.fsmSt != null ? (CORE1_COLORS[this.fsmSt] || '#9e9e9e') : '#555' }\n    },\n    watch: {\n      'msg.payload': {\n        immediate: true,\n        handler(d) { if (d && d.fsm_to != null) this.fsmSt = d.fsm_to; }\n      }\n    }\n  }\n</script>"
  },
  {
    "id": "w_fsm_cmds",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_fsm_cmds",
    "name": "Control FSM",
    "order": 1,
    "width": 12,
    "height": 5,
    "storeState": false,
    "passthru": false,
    "resendOnReconnect": false,
    "templateScope": "local",
    "className": "",
    "x": 700,
    "y": 680,
    "wires": [["fn_mk_cmd"]],
    "format": "<template>\n  <div style=\"padding:10px;font-size:13px\">\n    <div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:12px\">\n      <!-- Home -->\n      <div style=\"background:#1a1a2e;border:1px solid #2a2a4a;border-radius:6px;padding:10px\">\n        <div style=\"font-size:10px;color:#9e9e9e;margin-bottom:6px;letter-spacing:.05em\">IR A HOME</div>\n        <div style=\"font-size:10px;color:#666;margin-bottom:3px\">Velocidad (µm/s)</div>\n        <input type=\"number\" v-model.number=\"homeVel\" min=\"100\" max=\"5000\" step=\"100\"\n          style=\"width:100%;box-sizing:border-box;background:#111;color:#fff;border:1px solid #444;border-radius:4px;padding:5px 8px;font-size:13px;margin-bottom:8px\"/>\n        <button @click=\"send({payload:'fsm_home,'+homeVel.toFixed(1)})\"\n          style=\"width:100%;padding:7px;background:#1565C0;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer;font-weight:bold\">\n          ↩ Home\n        </button>\n      </div>\n      <!-- Buscar jeringa -->\n      <div style=\"background:#1a1a2e;border:1px solid #2a2a4a;border-radius:6px;padding:10px\">\n        <div style=\"font-size:10px;color:#9e9e9e;margin-bottom:6px;letter-spacing:.05em\">BUSCAR JERINGA</div>\n        <div style=\"font-size:10px;color:#666;margin-bottom:3px\">Velocidad (µm/s)</div>\n        <input type=\"number\" v-model.number=\"searchVel\" min=\"50\" max=\"1000\" step=\"50\"\n          style=\"width:100%;box-sizing:border-box;background:#111;color:#fff;border:1px solid #444;border-radius:4px;padding:5px 8px;font-size:13px;margin-bottom:8px\"/>\n        <button @click=\"send({payload:'fsm_search,'+searchVel.toFixed(1)})\"\n          style=\"width:100%;padding:7px;background:#00838F;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer;font-weight:bold\">\n          🔍 Buscar Jeringa\n        </button>\n      </div>\n      <!-- Dispensar -->\n      <div style=\"background:#1a1a2e;border:1px solid #2a2a4a;border-radius:6px;padding:10px\">\n        <div style=\"font-size:10px;color:#9e9e9e;margin-bottom:6px;letter-spacing:.05em\">DISPENSAR</div>\n        <div style=\"font-size:10px;color:#666;margin-bottom:3px\">Objetivo (µm)</div>\n        <input type=\"number\" v-model.number=\"dispTarget\" min=\"0\" step=\"1000\"\n          style=\"width:100%;box-sizing:border-box;background:#111;color:#fff;border:1px solid #444;border-radius:4px;padding:5px 8px;font-size:13px;margin-bottom:4px\"/>\n        <div style=\"font-size:10px;color:#666;margin-bottom:3px\">Velocidad (µm/s)</div>\n        <input type=\"number\" v-model.number=\"dispVel\" min=\"1\" max=\"5000\" step=\"100\"\n          style=\"width:100%;box-sizing:border-box;background:#111;color:#fff;border:1px solid #444;border-radius:4px;padding:5px 8px;font-size:13px;margin-bottom:8px\"/>\n        <button\n          @click=\"dispTarget>0 && dispVel>0 && send({payload:'fsm_dispense,'+dispTarget.toFixed(1)+','+dispVel.toFixed(1)})\"\n          :style=\"{width:'100%',padding:'7px',background:'#2E7D32',color:'#fff',border:'none',borderRadius:'4px',fontSize:'12px',cursor:'pointer',fontWeight:'bold',opacity:dispTarget>0&&dispVel>0?1:0.4}\">\n          ► Dispensar\n        </button>\n      </div>\n    </div>\n    <!-- Fila de acciones sin parámetros -->\n    <div style=\"display:flex;gap:8px;flex-wrap:wrap\">\n      <button @click=\"send({payload:'fsm_calibrate'})\"\n        style=\"flex:1;min-width:100px;padding:8px;background:#37474F;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer\">\n        Calibrar\n      </button>\n      <button @click=\"send({payload:'fsm_search_eot'})\"\n        style=\"flex:1;min-width:100px;padding:8px;background:#4527A0;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer\">\n        Buscar EOT\n      </button>\n      <button @click=\"send({payload:'fsm_cont'})\"\n        style=\"flex:1;min-width:100px;padding:8px;background:#1B5E20;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer\">\n        Continuar\n      </button>\n      <button @click=\"send({payload:'fsm_occ_rel'})\"\n        style=\"flex:1;min-width:100px;padding:8px;background:#1565C0;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer\">\n        Lib. Oclusión\n      </button>\n      <button @click=\"send({payload:'fsm_resume'})\"\n        style=\"flex:1;min-width:100px;padding:8px;background:#006064;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer\">\n        Reanudar\n      </button>\n      <button @click=\"send({payload:'fsm_reset'})\"\n        style=\"flex:1;min-width:100px;padding:8px;background:#6A1B9A;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer\">\n        Reset FSM\n      </button>\n    </div>\n  </div>\n</template>\n<script>\n  export default {\n    data() { return { homeVel: 1500, searchVel: 200, dispTarget: 30000, dispVel: 500 } }\n  }\n</script>"
  },
