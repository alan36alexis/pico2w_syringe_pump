  {
    "id": "fn_telem",
    "type": "function",
    "z": "fl_main",
    "name": "Router Telemetría EDA",
    "func": "try {\n  const d = JSON.parse(msg.payload);\n  const parts = msg.topic.split('/');\n  const devId = parts[1] || context.global.get('online_device_id') || 'bj-001';\n  const sub = parts[3]; // 'sensors', 'motion', 'session'\n\n  let outRate = null;\n  let outTelem = null;\n  let outChart = null;\n  let outState = null;\n\n  if (sub === 'sensors') {\n    outChart = { payload: d.pressure_mmhg, topic: devId + ' pres' };\n  } else if (sub === 'session') {\n    outRate = { payload: d.rate_ml_h };\n    outTelem = { payload: d, deviceId: devId };\n    if (d.fsm_state != null) {\n      outState = { payload: { fsm_to: d.fsm_state } };\n    }\n  } else if (sub === 'motion') {\n    outTelem = { payload: d, deviceId: devId };\n  }\n\n  return [outRate, outTelem, outChart, outState];\n} catch(e) {\n  return [null, null, null, null];\n}",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 60,
    "wires": [
      ["w_rate"],
      ["w_telem"],
      ["w_chart"],
      ["w_state", "w_fsm_state_ctrl"]
    ]
  },
  {
    "id": "fn_status",
    "type": "function",
    "z": "fl_main",
    "name": "Parse Status",
    "func": "try {\n  const d = JSON.parse(msg.payload);\n  if (d.id) context.global.set('online_device_id', d.id);\n  msg.payload = { state: d.state, id: d.id, fw: d.fw || 'sim', online: d.state === 'online' };\n  return msg;\n} catch(e) { return null; }",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 120,
    "wires": [["w_device"]]
  },
  {
    "id": "fn_event",
    "type": "function",
    "z": "fl_main",
    "name": "Format Evento",
    "func": "try {\n  const d = JSON.parse(msg.payload);\n  const t = new Date().toLocaleTimeString('es-MX');\n  const CORE1 = [\n    'ESPERANDO (UNHOMED)',\n    'HOMING',\n    'REL_LSW_INI',\n    'LISTO EN HOME',\n    'BUSCANDO JERINGA',\n    'JERINGA ACOPLADA',\n    'DISPENSANDO',\n    'FIN DE DISPENSADO',\n    'NUEVO DISPENSADO',\n    'BUSCANDO EOT',\n    'REL_LSW_FIN',\n    'FIN DE RECORRIDO',\n    'FALLA MOTOR',\n    'OCLUSIÓN FRENANDO',\n    'LIBERANDO OCLUSIÓN',\n    'PAUSA POR OCLUSIÓN',\n    'MANUAL OVERRIDE',\n    'CALIB INI (BUSCA 0)',\n    'CALIB FIN (BUSCA MAX)',\n    'FRENANDO LSW INI',\n    'FRENANDO LSW FIN'\n  ];\n  let log = context.global.get('event_log') || [];\n  let alarms = context.global.get('active_alarms') || {\n    occ: 0, bub: 0, eot: 0, emp: 0, drv: 0, bat: 0\n  };\n  let detail = '', fsmMsg = null;\n\n  if (d.type === 'alarm') {\n    const code = (d.code || '').toLowerCase();\n    alarms[code] = 1;\n    context.global.set('active_alarms', alarms);\n    detail = '⚠ ALARMA ' + code.toUpperCase() + ' (lvl ' + d.level + ')';\n  } else if (d.type === 'state') {\n    const from = CORE1[d.from] !== undefined ? CORE1[d.from] : String(d.from);\n    const to   = CORE1[d.to]   !== undefined ? CORE1[d.to]   : String(d.to);\n    detail = from + ' → ' + to;\n    context.global.set('fsm_state', d.to);\n    fsmMsg = { payload: { fsm_from: d.from, fsm_to: d.to } };\n    if (d.to === 3 || d.to === 6) {\n      alarms.occ = 0;\n      alarms.drv = 0;\n      context.global.set('active_alarms', alarms);\n    }\n  } else {\n    detail = d.msg || JSON.stringify(d);\n  }\n\n  log.unshift({ time: t, tipo: d.type || 'info', detalle: detail });\n  if (log.length > 25) log = log.slice(0, 25);\n  context.global.set('event_log', log);\n\n  const notif = (d.type === 'alarm')\n    ? { payload: '⚠ ALARMA: ' + (d.code||'').toUpperCase() + ' (nivel ' + d.level + ')', topic: 'error' }\n    : null;\n  const almMsg = { payload: { alm: alarms } };\n\n  return [{ payload: log }, notif, fsmMsg, almMsg];\n} catch(e) {\n  node.error('fn_event: ' + e.message, msg);\n  return [null, null, null, null];\n}",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 180,
    "wires": [
      ["w_events"],
      ["w_notif"],
      ["w_state", "w_fsm_state_ctrl"],
      ["w_alm"]
    ]
  },
  {
    "id": "fn_ack",
    "type": "function",
    "z": "fl_main",
    "name": "Format ACK",
    "func": "try {\n  const d = JSON.parse(msg.payload);\n  msg.payload = '#' + d.cid + ': ' + d.result + (d.reason ? ' (' + d.reason + ')' : '');\n  return msg;\n} catch(e) { return null; }",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 240,
    "wires": [["w_ack"]]
  },
  {
    "id": "fn_mk_cmd",
    "type": "function",
    "z": "fl_main",
    "name": "Make CMD",
    "func": "const devId = context.global.get('online_device_id') || 'bj-deadbeef';\nlet cid = (context.global.get('cmd_cid') || 0) + 1;\ncontext.global.set('cmd_cid', cid);\nmsg.topic = 'bj/' + devId + '/cmd';\nmsg.payload = JSON.stringify({ cid: cid, cmd: String(msg.payload) });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 760,
    "y": 500,
    "wires": [["n_cmd_out"]]
  },
  {
    "id": "fn_fault_topic",
    "type": "function",
    "z": "fl_main",
    "name": "Fault Topic",
    "func": "const devId = context.global.get('online_device_id') || 'bj-deadbeef';\nmsg.topic = 'bj/' + devId + '/sim_fault';\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 760,
    "y": 580,
    "wires": [["n_fault_out"]]
  },
  {
    "id": "w_device",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_dev",
    "name": "Dispositivo",
    "order": 1,
    "width": 6,
    "height": 2,
    "storeState": true,
    "passthru": false,
    "resendOnReconnect": true,
    "templateScope": "local",
    "className": "",
    "x": 560,
    "y": 120,
    "wires": [],
    "format": "<template>\n  <div style=\"padding:8px\">\n    <div style=\"display:flex;align-items:center;gap:8px\">\n      <div :style=\"{width:'10px',height:'10px',borderRadius:'50%',background:msg.payload&&msg.payload.online?'#4caf50':'#f44336'}\"></div>\n      <b style=\"font-size:16px\">{{ msg.payload && msg.payload.id || '—' }}</b>\n    </div>\n    <div style=\"font-size:11px;opacity:0.6;margin-top:4px\">fw: {{ msg.payload && msg.payload.fw || '—' }}</div>\n  </div>\n</template>"
  },
  {
    "id": "w_state",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_state",
    "name": "Estado",
    "order": 1,
    "width": 6,
    "height": 3,
    "storeState": true,
    "passthru": false,
    "resendOnReconnect": true,
    "templateScope": "local",
    "className": "",
    "x": 560,
    "y": 60,
    "wires": [],
    "format": "<template>\n  <div style=\"padding:12px;text-align:center\">\n    <div style=\"font-size:10px;letter-spacing:.12em;opacity:0.5;margin-bottom:6px\">ESTADO MOTOR (Core1 FSM)</div>\n    <div :style=\"{fontSize:'20px',fontWeight:'bold',color:fsmColor,transition:'color 0.3s'}\">{{ fsmLabel }}</div>\n    <div v-if=\"fsmSt !== null\" style=\"font-size:11px;opacity:0.4;margin-top:4px\">estado #{{ fsmSt }}</div>\n  </div>\n</template>\n<script>\n  const CORE1_LABELS = [\n    'ESPERANDO (UNHOMED)',\n    'HOMING',\n    'REL_LSW_INI',\n    'LISTO EN HOME',\n    'BUSCANDO JERINGA',\n    'JERINGA ACOPLADA',\n    'DISPENSANDO',\n    'FIN DE DISPENSADO',\n    'NUEVO DISPENSADO',\n    'BUSCANDO EOT',\n    'REL_LSW_FIN',\n    'FIN DE RECORRIDO',\n    'FALLA MOTOR',\n    'OCLUSIÓN FRENANDO',\n    'LIBERANDO OCLUSIÓN',\n    'PAUSA POR OCLUSIÓN',\n    'MANUAL OVERRIDE',\n    'CALIB INI (BUSCA 0)',\n    'CALIB FIN (BUSCA MAX)',\n    'FRENANDO LSW INI',\n    'FRENANDO LSW FIN'\n  ];\n  const CORE1_COLORS = [\n    '#9e9e9e','#ffb300','#ffb300','#4caf50',\n    '#2196f3','#00bcd4','#4caf50','#8bc34a',\n    '#9e9e9e','#2196f3','#ffb300','#9e9e9e',\n    '#f44336','#f44336','#ffb300','#ff9800',\n    '#9c27b0','#00bcd4','#00bcd4','#ffb300','#ffb300'\n  ];\n  export default {\n    data() { return { fsmSt: null } },\n    computed: {\n      fsmLabel() { return this.fsmSt != null ? (CORE1_LABELS[this.fsmSt] || String(this.fsmSt)) : 'SIN DATOS' },\n      fsmColor() { return this.fsmSt != null ? (CORE1_COLORS[this.fsmSt] || '#9e9e9e') : '#555' }\n    },\n    watch: {\n      'msg.payload': {\n        immediate: true,\n        handler(d) {\n          if (!d) return;\n          if (typeof d === 'number') this.fsmSt = d;\n          else if (d.fsm_state != null) this.fsmSt = d.fsm_state;\n          else if (d.fsm_to != null) this.fsmSt = d.fsm_to;\n        }\n      }\n    }\n  }\n</script>"
  },
  {
    "id": "w_telem",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_telem",
    "name": "Stats Infusión",
    "order": 1,
    "width": 6,
    "height": 3,
    "storeState": true,
    "passthru": false,
    "resendOnReconnect": true,
    "templateScope": "local",
    "className": "",
    "x": 560,
    "y": 180,
    "wires": [],
    "format": "<template>\n  <div style=\"padding:8px;font-size:13px\">\n    <div style=\"display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid #333\">\n      <span>Infundido</span>\n      <b>{{ inf.toFixed(2) }} mL</b>\n    </div>\n    <div style=\"display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid #333\">\n      <span>Objetivo</span>\n      <b>{{ tgt.toFixed(2) }} mL</b>\n    </div>\n    <div style=\"display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid #333\">\n      <span>Transcurrido</span>\n      <b>{{ timeStr }}</b>\n    </div>\n    <div style=\"display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid #333\">\n      <span>Restante</span>\n      <b>{{ remStr }}</b>\n    </div>\n    <div style=\"display:flex;justify-content:space-between;padding:4px 0;border-bottom:1px solid #333\">\n      <span>Posición émbolo</span>\n      <b>{{ posMm.toFixed(2) }} mm</b>\n    </div>\n    <div style=\"margin-top:6px\">\n      <div style=\"display:flex;justify-content:space-between;font-size:11px;opacity:0.7;margin-bottom:2px\">\n        <span>Progreso</span>\n        <b>{{ progPct.toFixed(1) }}%</b>\n      </div>\n      <div style=\"width:100%;height:6px;background:#2a2a4a;border-radius:3px;overflow:hidden\">\n        <div :style=\"{width: Math.min(progPct, 100) + '%', height: '100%', background: '#4caf50', transition: 'width 0.4s'}\"></div>\n      </div>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  data() {\n    return {\n      inf: 0.0,\n      tgt: 0.0,\n      elaS: 0,\n      rate: 0.0,\n      posMm: 0.0,\n      progPct: 0.0\n    };\n  },\n  computed: {\n    timeStr() {\n      const s = this.elaS || 0;\n      const h = Math.floor(s / 3600);\n      const m = Math.floor((s % 3600) / 60);\n      const sec = Math.floor(s % 60);\n      return h + 'h ' + m + 'm ' + sec + 's';\n    },\n    remStr() {\n      if (this.rate > 0 && this.tgt > this.inf) {\n        const remH = (this.tgt - this.inf) / this.rate;\n        return (remH * 60).toFixed(1) + ' min';\n      }\n      return '—';\n    }\n  },\n  watch: {\n    'msg.payload': {\n      immediate: true,\n      handler(d) {\n        if (!d) return;\n        if (d.infused_ml != null)  this.inf     = d.infused_ml;\n        if (d.target_ml != null)   this.tgt     = d.target_ml;\n        if (d.rate_ml_h != null)   this.rate    = d.rate_ml_h;\n        if (d.elapsed_s != null)   this.elaS    = d.elapsed_s;\n        if (d.position_mm != null) this.posMm   = d.position_mm;\n        if (d.progress_pct != null)this.progPct = d.progress_pct;\n      }\n    }\n  }\n}\n</script>"
  },
  {
    "id": "w_rate",
    "type": "ui-gauge",
    "z": "fl_main",
    "group": "grp_rate",
    "name": "Caudal",
    "order": 1,
    "width": 6,
    "height": 4,
    "label": "Caudal",
    "format": "{{value}} mL/h",
    "gtype": "gauge-half",
    "gstyle": "needle",
    "min": 0,
    "max": 500,
    "sizeThickness": 16,
    "sizeGap": 4,
    "sizeKeyThickness": 8,
    "styleRounded": true,
    "styleGlow": false,
    "segments": [
      {"from": 0,   "color": "#4caf50"},
      {"from": 200, "color": "#ffb300"},
      {"from": 400, "color": "#f44336"}
    ],
    "className": "",
    "x": 560,
    "y": 60,
    "wires": []
  },
  {
    "id": "w_chart",
    "type": "ui-chart",
    "z": "fl_main",
    "group": "grp_chart",
    "name": "Fuerza ADC",
    "label": "Fuerza sensor ADC (mmHg)",
    "order": 1,
    "chartType": "line",
    "category": "topic",
    "categoryType": "msg",
    "xAxisType": "time",
    "xAxisFormat": "HH:mm:ss",
    "removeOlder": 5,
