[
  {
    "id": "cf_broker",
    "type": "mqtt-broker",
    "name": "Mosquitto Docker",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "nodered_dashboard",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
