  {
    "id": "w_alm",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_alm",
    "name": "Alarmas",
    "order": 1,
    "width": 12,
    "height": 2,
    "storeState": true,
    "passthru": false,
    "resendOnReconnect": true,
    "templateScope": "local",
    "className": "",
    "x": 560,
    "y": 380,
    "wires": [],
    "format": "<template>\n  <div style=\"display:flex;flex-wrap:wrap;gap:8px;padding:8px\">\n    <span v-for=\"(v,k) in (msg.payload && msg.payload.alm || {})\" :key=\"k\"\n          :style=\"{padding:'4px 14px',borderRadius:'4px',fontWeight:'bold',fontSize:'13px',\n                   background:v?'#b71c1c':'#1b5e20',color:'#fff',transition:'background 0.3s'}\">\n      {{ k.toUpperCase() }}: {{ v ? '⚠' : '✓' }}\n    </span>\n  </div>\n</template>"
  },
  {
    "id": "w_fsm_state_ctrl",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_fsm_status",
    "name": "Estado FSM",
    "order": 1,
    "width": 12,
    "height": 2,
    "storeState": true,
    "passthru": false,
    "resendOnReconnect": true,
    "templateScope": "local",
    "className": "",
    "x": 700,
    "y": 600,
    "wires": [],
    "format": "<template>\n  <div style=\"display:flex;align-items:center;justify-content:center;gap:24px;padding:12px;height:100%\">\n    <div style=\"text-align:center\">\n      <div style=\"font-size:9px;letter-spacing:.12em;opacity:0.4;margin-bottom:6px\">ESTADO MOTOR (Core1 FSM)</div>\n      <div :style=\"{fontSize:'32px',fontWeight:'bold',color:fsmColor,transition:'color 0.4s',letterSpacing:'.02em'}\">{{ fsmLabel }}</div>\n      <div v-if=\"fsmSt !== null\" style=\"font-size:11px;opacity:0.35;margin-top:4px\">estado #{{ fsmSt }}</div>\n    </div>\n    <div :style=\"{width:'14px',height:'14px',borderRadius:'50%',background:fsmColor,boxShadow:'0 0 8px '+fsmColor,transition:'background 0.4s',flexShrink:0}\"></div>\n  </div>\n</template>\n<script>\n  const CORE1_LABELS = [\n    'ESPERANDO (UNHOMED)',\n    'HOMING',\n    'REL_LSW_INI',\n    'LISTO EN HOME',\n    'BUSCANDO JERINGA',\n    'JERINGA ACOPLADA',\n    'DISPENSANDO',\n    'FIN DE DISPENSADO',\n    'NUEVO DISPENSADO',\n    'BUSCANDO EOT',\n    'REL_LSW_FIN',\n    'FIN DE RECORRIDO',\n    'FALLA MOTOR',\n    'OCLUSIÓN FRENANDO',\n    'LIBERANDO OCLUSIÓN',\n    'PAUSA POR OCLUSIÓN',\n    'MANUAL OVERRIDE',\n    'CALIB INI (BUSCA 0)',\n    'CALIB FIN (BUSCA MAX)',\n    'FRENANDO LSW INI',\n    'FRENANDO LSW FIN'\n  ];\n  const CORE1_COLORS = [\n    '#9e9e9e','#ffb300','#ffb300','#4caf50',\n    '#2196f3','#00bcd4','#4caf50','#8bc34a',\n    '#9e9e9e','#2196f3','#ffb300','#9e9e9e',\n    '#f44336','#f44336','#ffb300','#ff9800',\n    '#9c27b0','#00bcd4','#00bcd4','#ffb300','#ffb300'\n  ];\n  export default {\n    data() { return { fsmSt: null } },\n    computed: {\n      fsmLabel() { return this.fsmSt != null ? (CORE1_LABELS[this.fsmSt] || String(this.fsmSt)) : 'SIN DATOS' },\n      fsmColor() { return this.fsmSt != null ? (CORE1_COLORS[this.fsmSt] || '#9e9e9e') : '#555' }\n    },\n    watch: {\n      'msg.payload': {\n        immediate: true,\n        handler(d) {\n          if (!d) return;\n          if (typeof d === 'number') this.fsmSt = d;\n          else if (d.fsm_state != null) this.fsmSt = d.fsm_state;\n          else if (d.fsm_to != null) this.fsmSt = d.fsm_to;\n        }\n      }\n    }\n  }\n</script>"
  },
  {
    "id": "w_fsm_cmds",
    "type": "ui-template",
    "z": "fl_main",
    "group": "grp_fsm_cmds",
    "name": "Control FSM",
    "order": 1,
    "width": 12,
    "height": 5,
    "storeState": false,
    "passthru": false,
    "resendOnReconnect": false,
    "templateScope": "local",
    "className": "",
    "x": 700,
    "y": 680,
    "wires": [["fn_mk_cmd"]],
    "format": "<template>\n  <div style=\"padding:10px;font-size:13px\">\n    <div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-bottom:12px\">\n      <!-- Home -->\n      <div style=\"background:#1a1a2e;border:1px solid #2a2a4a;border-radius:6px;padding:10px\">\n        <div style=\"font-size:10px;color:#9e9e9e;margin-bottom:6px;letter-spacing:.05em\">IR A HOME</div>\n        <div style=\"font-size:10px;color:#666;margin-bottom:3px\">Velocidad (µm/s)</div>\n        <input type=\"number\" v-model.number=\"homeVel\" min=\"100\" max=\"5000\" step=\"100\"\n          style=\"width:100%;box-sizing:border-box;background:#111;color:#fff;border:1px solid #444;border-radius:4px;padding:5px 8px;font-size:13px;margin-bottom:8px\"/>\n        <button @click=\"send({payload:'fsm_home,'+homeVel.toFixed(1)})\"\n          style=\"width:100%;padding:7px;background:#1565C0;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer;font-weight:bold\">\n          ↩ Home\n        </button>\n      </div>\n      <!-- Buscar jeringa -->\n      <div style=\"background:#1a1a2e;border:1px solid #2a2a4a;border-radius:6px;padding:10px\">\n        <div style=\"font-size:10px;color:#9e9e9e;margin-bottom:6px;letter-spacing:.05em\">BUSCAR JERINGA</div>\n        <div style=\"font-size:10px;color:#666;margin-bottom:3px\">Velocidad (µm/s)</div>\n        <input type=\"number\" v-model.number=\"searchVel\" min=\"50\" max=\"1000\" step=\"50\"\n          style=\"width:100%;box-sizing:border-box;background:#111;color:#fff;border:1px solid #444;border-radius:4px;padding:5px 8px;font-size:13px;margin-bottom:8px\"/>\n        <button @click=\"send({payload:'fsm_search,'+searchVel.toFixed(1)})\"\n          style=\"width:100%;padding:7px;background:#00838F;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer;font-weight:bold\">\n          🔍 Buscar Jeringa\n        </button>\n      </div>\n      <!-- Dispensar -->\n      <div style=\"background:#1a1a2e;border:1px solid #2a2a4a;border-radius:6px;padding:10px\">\n        <div style=\"font-size:10px;color:#9e9e9e;margin-bottom:6px;letter-spacing:.05em\">DISPENSAR</div>\n        <div style=\"font-size:10px;color:#666;margin-bottom:3px\">Objetivo (µm)</div>\n        <input type=\"number\" v-model.number=\"dispTarget\" min=\"0\" step=\"1000\"\n          style=\"width:100%;box-sizing:border-box;background:#111;color:#fff;border:1px solid #444;border-radius:4px;padding:5px 8px;font-size:13px;margin-bottom:4px\"/>\n        <div style=\"font-size:10px;color:#666;margin-bottom:3px\">Velocidad (µm/s)</div>\n        <input type=\"number\" v-model.number=\"dispVel\" min=\"1\" max=\"5000\" step=\"100\"\n          style=\"width:100%;box-sizing:border-box;background:#111;color:#fff;border:1px solid #444;border-radius:4px;padding:5px 8px;font-size:13px;margin-bottom:8px\"/>\n        <button\n          @click=\"dispTarget>0 && dispVel>0 && send({payload:'fsm_dispense,'+dispTarget.toFixed(1)+','+dispVel.toFixed(1)})\"\n          :style=\"{width:'100%',padding:'7px',background:'#2E7D32',color:'#fff',border:'none',borderRadius:'4px',fontSize:'12px',cursor:'pointer',fontWeight:'bold',opacity:dispTarget>0&&dispVel>0?1:0.4}\">\n          ► Dispensar\n        </button>\n      </div>\n    </div>\n    <!-- Fila de acciones sin parámetros -->\n    <div style=\"display:flex;gap:8px;flex-wrap:wrap\">\n      <button @click=\"send({payload:'fsm_calibrate'})\"\n        style=\"flex:1;min-width:100px;padding:8px;background:#37474F;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer\">\n        Calibrar\n      </button>\n      <button @click=\"send({payload:'fsm_search_eot'})\"\n        style=\"flex:1;min-width:100px;padding:8px;background:#4527A0;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer\">\n        Buscar EOT\n      </button>\n      <button @click=\"send({payload:'fsm_cont'})\"\n        style=\"flex:1;min-width:100px;padding:8px;background:#1B5E20;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer\">\n        Continuar\n      </button>\n      <button @click=\"send({payload:'fsm_occ_rel'})\"\n        style=\"flex:1;min-width:100px;padding:8px;background:#1565C0;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer\">\n        Lib. Oclusión\n      </button>\n      <button @click=\"send({payload:'fsm_resume'})\"\n        style=\"flex:1;min-width:100px;padding:8px;background:#006064;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer\">\n        Reanudar\n      </button>\n      <button @click=\"send({payload:'fsm_reset'})\"\n        style=\"flex:1;min-width:100px;padding:8px;background:#6A1B9A;color:#fff;border:none;border-radius:4px;font-size:12px;cursor:pointer\">\n        Reset FSM\n      </button>\n    </div>\n  </div>\n</template>\n<script>\n  export default {\n    data() { return { homeVel: 1500, searchVel: 200, dispTarget: 30000, dispVel: 500 } }\n  }\n</script>"
  },
